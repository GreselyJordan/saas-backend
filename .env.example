# ============================================
# BASE DE DATOS MySQL
# ============================================
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# ============================================
# SEGURIDAD — Genera valores seguros con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_aleatoria
SUPER_ADMIN_KEY=cambia_esto_por_otra_clave_muy_larga_y_aleatoria

# ============================================
# CORS — URLs del frontend (separadas por coma)
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development
